{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lost-in-extraction/run-record.schema.json",
  "title": "Lost in Extraction — Paper 1 Run Record",
  "description": "One immutable extraction attempt, including exact-input hashes, inference settings, raw output, parsed model record, and deterministic validation results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "item_id",
    "language",
    "input_condition",
    "model_provider",
    "model_id",
    "model_version",
    "provider_request_id",
    "run_timestamp_utc",
    "prompt_version",
    "schema_version",
    "source_text_sha256",
    "prompt_sha256",
    "pivot_translation_id",
    "decoding",
    "raw_response",
    "parse_status",
    "syntax_repair_applied",
    "syntax_repair_description",
    "parsed_output",
    "validation_report",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "runtime_error"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "item_id": { "type": "string", "minLength": 1 },
    "language": {
      "type": "string",
      "enum": ["English", "Turkish", "Arabic", "Persian", "Urdu", "Pashto"]
    },
    "input_condition": {
      "type": "string",
      "enum": ["english_control", "original_language", "english_pivot"]
    },
    "model_provider": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": ["string", "null"], "minLength": 1 },
    "provider_request_id": { "type": ["string", "null"], "minLength": 1 },
    "run_timestamp_utc": { "type": "string", "format": "date-time" },
    "prompt_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "source_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pivot_translation_id": { "type": ["string", "null"], "minLength": 1 },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "seed",
        "max_output_tokens",
        "tools_enabled",
        "browsing_enabled",
        "retrieval_enabled",
        "response_format"
      ],
      "properties": {
        "temperature": { "type": ["number", "null"] },
        "top_p": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "seed": { "type": ["integer", "null"] },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "tools_enabled": { "const": false },
        "browsing_enabled": { "const": false },
        "retrieval_enabled": { "const": false },
        "response_format": {
          "type": "string",
          "enum": ["json_schema", "json_object", "text_json"]
        }
      }
    },
    "raw_response": { "type": "string" },
    "parse_status": {
      "type": "string",
      "enum": ["parsed_json", "repaired_json", "invalid_json", "runtime_error"]
    },
    "syntax_repair_applied": { "type": "boolean" },
    "syntax_repair_description": { "type": ["string", "null"], "minLength": 1 },
    "parsed_output": {
      "oneOf": [
        { "$ref": "https://example.org/lost-in-extraction/lean-event-record.schema.json" },
        { "type": "null" }
      ]
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_contract_valid", "substring_valid", "errors"],
      "properties": {
        "schema_contract_valid": { "type": "boolean" },
        "substring_valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "code", "field", "message"],
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "runtime_error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_class", "message"],
          "properties": {
            "error_class": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "language": { "const": "English" } }, "required": ["language"] },
      "then": {
        "properties": {
          "input_condition": { "const": "english_control" },
          "pivot_translation_id": { "const": null }
        }
      },
      "else": {
        "properties": {
          "input_condition": { "enum": ["original_language", "english_pivot"] }
        }
      }
    },
    {
      "if": { "properties": { "input_condition": { "const": "english_pivot" } }, "required": ["input_condition"] },
      "then": { "properties": { "pivot_translation_id": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "pivot_translation_id": { "const": null } } }
    },
    {
      "if": {
        "properties": { "parse_status": { "enum": ["parsed_json", "repaired_json"] } },
        "required": ["parse_status"]
      },
      "then": { "properties": { "parsed_output": { "$ref": "https://example.org/lost-in-extraction/lean-event-record.schema.json" } } },
      "else": {
        "properties": {
          "parsed_output": { "const": null },
          "validation_report": {
            "properties": {
              "schema_contract_valid": { "const": false },
              "substring_valid": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "syntax_repair_applied": { "const": true } }, "required": ["syntax_repair_applied"] },
      "then": {
        "properties": {
          "parse_status": { "const": "repaired_json" },
          "syntax_repair_description": { "type": "string", "minLength": 1 }
        }
      },
      "else": { "properties": { "syntax_repair_description": { "const": null } } }
    },
    {
      "if": { "properties": { "parse_status": { "const": "repaired_json" } }, "required": ["parse_status"] },
      "then": { "properties": { "syntax_repair_applied": { "const": true } } }
    },
    {
      "if": { "properties": { "parse_status": { "const": "runtime_error" } }, "required": ["parse_status"] },
      "then": {
        "properties": {
          "runtime_error": {
            "type": "object",
            "required": ["error_class", "message"]
          }
        }
      },
      "else": { "properties": { "runtime_error": { "const": null } } }
    }
  ]
}
